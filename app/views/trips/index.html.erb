<div class="container trips-page">
  <h1 class="titre">Liste des trips</h1>

  <div class="trips-list">
    <ul class="row g-3 mb-4 list-unstyled">
      <li class="col-12 col-md-4">
        <div class="destination-card">
          <%= image_tag "TK.jpg", alt: "Rue de Tokyo aux enseignes lumineuses" %>
          <h2>Tokyo</h2>
        </div>
      </li>

      <li class="col-12 col-md-4">
        <div class="destination-card">
          <%= image_tag "sydney.jpg", alt: "Opéra de Sydney au bord de l’eau" %>
          <h2>Sydney</h2>
        </div>
      </li>

      <li class="col-12 col-md-4">
        <div class="destination-card">
          <%= image_tag "zanzibar.jpg", alt: "Plage de Zanzibar et eau turquoise" %>
          <h2>Zanzibar</h2>
        </div>
      </li>

      <% @trips.each do |trip| %>
        <li><%= link_to trip.title, trip_path(trip) %></li>
        <li><%= link_to "Delete", trip_path(trip), data: { turbo_method: :delete, turbo_confirm: "Etes-vous sûr?"},
    class: "btn btn-outline-danger btn-sm ms-2" %></li>
      <% end %>
    </ul>
  </div>

  <%= link_to "Créer un nouveau trip", new_trip_path %>
</div>
