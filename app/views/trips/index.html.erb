<h1>Liste des trips</h1>

<ul>
  <% @trips.each do |trip| %>
    <li><%= link_to trip.title, trip_path(trip) %>
    <%= link_to "Delete", trip_path(trip), data: { turbo_method: :delete, turbo_confirm: "Etes-vous sûr?"},
    class: "btn btn-outline-danger btn-sm ms-2" %>
    </li>
  <% end %>
</ul>

<%= link_to "Créer un nouveau trip", new_trip_path %>
