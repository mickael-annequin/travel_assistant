<div class="container trips-page">
  <h1 class="titre">Liste des trips</h1>

  <div class="trips-list">
    <ul class="row g-3 mb-4 list-unstyled">

      <% @trips.each do |trip| %>
        <li class="col-12 col-md-4">
          <div class="destination-card">
            <%= link_to trip_path(trip) do %>
              <%= image_tag trip.photo_url, alt: trip.destination if trip.photo_url.present? %>
            <% end %>
            <h2><%= link_to trip.title, trip_path(trip) %></h2>
            <p>
              <%= link_to "🗑️", trip_path(trip),
                          data: { turbo_method: :delete, turbo_confirm: "Etes-vous sûr ?" },
                          class: "btn btn-outline-danger btn-sm ms-2" %>
            </p>
          </div>
        </li>
      <% end %>

    </ul>
  </div>

  <%= link_to "Créer un nouveau trip", new_trip_path %>
</div>
