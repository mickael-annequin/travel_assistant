<div class="container trips-page">

  <div class="d-flex justify-content-between align-items-center">
    <h1 class="titre">Liste des voyages</h1>
    <%= link_to "Créer un nouveau trip", new_trip_path, class: "btn-new-trip" %>
  </div>
    <div class="trips-list">
    <ul class="row g-3 mb-4 list-unstyled">

      <% @trips.each do |trip| %>
        <li class="col-12 col-md-4">
          <div class="destination-card">
            <%= link_to trip_path(trip) do %>
              <%= image_tag trip.photo_url, alt: trip.destination if trip.photo_url.present? %>
            <% end %>
            <h2><%= link_to trip.title, trip_path(trip),class: "text-decoration-none fw-bold text-body fs-1" %></h2>
            <p>
              <%= link_to "🗑️", trip_path(trip),
                          data: { turbo_method: :delete, turbo_confirm: "Etes-vous sûr ?" },
                          class: "delete-btn",
                          title: "Supprimer" %>
            </p>
          </div>
        </li>
      <% end %>

    </ul>
  </div>
</div>
