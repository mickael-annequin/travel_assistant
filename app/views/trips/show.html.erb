<%= turbo_stream_from @trip %>


<div class="trip-show">
  <div class="container-fluid trip-main">
    <div class="row h-100">

      <div class="col-4 col-lg-3 trip-sidebar">

        <div class="trip-card position-relative mb-3">
          <h1 class="fw-bold pe-5"><%= @trip.title %></h1>

          <%= link_to "🗑️", trip_path(@trip),
            data: { turbo_method: :delete, turbo_confirm: "Êtes-vous sûr ?" },
            class: "delete-btn",
            title: "Supprimer" %>

          <% if @trip.photo_url.present? %>
            <%= image_tag @trip.photo_url, alt: @trip.destination, class: "img-fluid rounded-4 mb-2" %>
            <p class="small text-muted mb-0">Photo de <%= @trip.photo_credit&.titleize %> - Unsplash</p>
          <% end %>
        </div>

        <div class="trip-card mb-3">
          <ul class="list-unstyled trip-infos mb-0">
            <li>
              <i class="fa-solid fa-location-dot"></i> <%= @trip.destination %>
            </li>
            <li>
              <i class="fa-solid fa-calendar-days"></i>
              Du <strong><%= @trip.start_date&.strftime("%d/%m/%Y") %></strong>
              au <strong><%= @trip.end_date&.strftime("%d/%m/%Y") %></strong>
            </li>
            <li>
              <i class="fa-solid fa-heart"></i> Centres d'intérêt : <%= @trip.interests %>
            </li>
            <% if @trip.other.present? %>
              <li>
                <i class="fa-solid fa-circle-info"></i> Autres : <%= @trip.other %>
              </li>
            <% end %>
          </ul>
        </div>

        <div class="trip-card">
          <h2 class="h5 fw-bold mb-3"><i class="fa-solid fa-star text-warning me-2"></i> Mes favoris</h2>
          <% if @trip.bookmarks.empty? %>
            <p class="mb-0">Aucun favori pour le moment</p>
          <% else %>
            <ul class="list-unstyled text-muted small mb-0">
              <% @trip.bookmarks.each do |bookmark| %>
              <li class="trip-card bookmark-card mt-3">
                <strong><%= bookmark.name %></strong> - <%= bookmark.description %>
                <%= link_to "🗑️", bookmark_path(bookmark),
                            data: { turbo_method: :delete, turbo_confirm: "Supprimer ce favori ?" },
                            class: "bookmark-delete-btn",
                            title: "Supprimer" %>
              </li>
              <% end %>
            </ul>
          <% end %>
        </div>

      </div> <!-- fin trip-sidebar -->

      <div class="col-8 col-lg-9 trip-chat pt-3">
        <div id="messages" class="chat-messages">
          <% @trip.messages.each do |message| %>
            <%= render "messages/message", message: message %>
          <% end %>
        </div> <!-- fin messages -->

        <div class="trip-actions bg-white border rounded-4 p-3 my-3">
          <div id="new_message_container" class="flex-grow-1">
            <%= render "messages/form", trip: @trip, message: @message %>
          </div> <!-- fin new_message_container -->

        </div> <!-- fin trip-actions -->
      </div> <!-- fin trip-chat -->

    </div> <!-- fin row -->
  </div> <!-- fin container-fluid -->
</div> <!-- fin trip-show -->
