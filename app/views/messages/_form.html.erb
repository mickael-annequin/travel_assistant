  <%= simple_form_for [trip, message] do |f| %>
    <%= f.input :content,
      as: :string,
      label: false,
      required: true,
      placeholder: "D'autres idées de visite?",
      wrapper_html: { class: "mb-0" },
      input_html: { class: "rounded-pill px-4" } %>
    <%= f.button :submit, 'Go !', class: 'btn btn-primary rounded-pill px-4' %>
  <% end %>
